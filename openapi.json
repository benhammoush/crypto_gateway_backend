{
  "openapi": "3.1.0",
  "info": {
    "title": "crypto_gateway",
    "version": "0.2.1",
    "description": "Non-custodial USD-to-SOL Devnet payments. Merchant endpoints require server-side credentials; checkout endpoints require payment-scoped capabilities."
  },
  "paths": {
    "/v1/payments": {
      "post": {
        "operationId": "createPayment",
        "security": [{ "merchantBearer": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePayment" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Payment" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/payments/{id}": {
      "get": {
        "operationId": "getPayment",
        "security": [{ "merchantBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Payment" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/checkout/{id}": {
      "get": {
        "operationId": "getCheckout",
        "security": [{ "checkoutBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Payment" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/checkout/{id}/rpc": {
      "post": {
        "operationId": "checkoutRpc",
        "description": "Bounded read-only RPC for active unsettled payments. Only getGenesisHash with [] and getLatestBlockhash with [{commitment: finalized}]. No batches, notifications, arbitrary destinations or transaction submission. Limited to 12 requests per checkout/minute and 60 globally/minute in addition to existing limits. Provider failures are sanitized gateway errors.",
        "security": [{ "checkoutBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckoutRpcRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC 2.0 result, not a gateway data envelope. Provider credentials and extra fields are never returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CheckoutRpcResult" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/checkout/{id}/transactions": {
      "post": {
        "operationId": "submitTransaction",
        "security": [{ "checkoutBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["signature"],
                "properties": {
                  "signature": {
                    "type": "string",
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,100}$",
                    "description": "Must decode to exactly 64 bytes."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Payment" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "merchantBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Backend-only merchant API credential."
      },
      "checkoutBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Payment-scoped checkout capability."
      }
    },
    "parameters": {
      "PaymentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^[a-f0-9-]{36}$" }
      }
    },
    "responses": {
      "Payment": {
        "description": "Authoritative payment state. Creation and merchant reads include checkoutUrl; checkout reads do not.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PaymentEnvelope" }
          }
        }
      },
      "Error": {
        "description": "400/401/403/404/409/413/415/422/429/500/503. Retry provider failures safely; never infer payment failure from transport errors.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "RpcId": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 64 },
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        ]
      },
      "CheckoutRpcRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jsonrpc", "id", "method", "params"],
        "properties": {
          "jsonrpc": { "const": "2.0", "type": "string" },
          "id": { "$ref": "#/components/schemas/RpcId" },
          "method": {
            "type": "string",
            "enum": ["getGenesisHash", "getLatestBlockhash"]
          },
          "params": { "type": "array" }
        },
        "oneOf": [
          {
            "properties": {
              "method": { "const": "getGenesisHash" },
              "params": { "type": "array", "maxItems": 0 }
            }
          },
          {
            "properties": {
              "method": { "const": "getLatestBlockhash" },
              "params": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["commitment"],
                  "properties": {
                    "commitment": { "type": "string", "const": "finalized" }
                  }
                }
              }
            }
          }
        ]
      },
      "CheckoutRpcResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jsonrpc", "id", "result"],
        "properties": {
          "jsonrpc": { "type": "string", "const": "2.0" },
          "id": { "$ref": "#/components/schemas/RpcId" },
          "result": {
            "oneOf": [
              {
                "type": "string",
                "const": "EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["context", "value"],
                "properties": {
                  "context": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["slot"],
                    "properties": {
                      "slot": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "value": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["blockhash", "lastValidBlockHeight"],
                    "properties": {
                      "blockhash": {
                        "type": "string",
                        "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
                        "description": "Must decode to exactly 32 bytes."
                      },
                      "lastValidBlockHeight": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "CreatePayment": {
        "type": "object",
        "additionalProperties": false,
        "required": ["usdCents", "merchantReference"],
        "properties": {
          "usdCents": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "merchantReference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "description": "Opaque reference, not customer PII."
          }
        }
      },
      "Payment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "merchantReference",
          "usdCents",
          "lamports",
          "displaySol",
          "network",
          "asset",
          "recipient",
          "memo",
          "rpcUrl",
          "quote",
          "createdAt",
          "expiresAt",
          "status",
          "signature",
          "settledAt",
          "attempts"
        ],
        "properties": {
          "id": { "type": "string" },
          "merchantReference": { "type": "string" },
          "usdCents": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "lamports": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "displaySol": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{9}$" },
          "network": { "type": "string", "const": "solana-devnet" },
          "asset": { "type": "string", "const": "SOL" },
          "recipient": { "type": "string" },
          "memo": { "type": "string" },
          "rpcUrl": {
            "type": "string",
            "deprecated": true,
            "description": "Legacy public Devnet URL only; never the configured provider URL. New checkout clients use authenticated POST /v1/checkout/{id}/rpc instead."
          },
          "quote": {
            "type": "object",
            "additionalProperties": false,
            "required": ["usdPrice", "blockId"],
            "properties": {
              "usdPrice": { "type": "string" },
              "blockId": { "type": "integer" }
            }
          },
          "createdAt": { "type": "integer" },
          "expiresAt": { "type": "integer" },
          "status": {
            "type": "string",
            "enum": ["pending", "verifying", "settled", "expired"]
          },
          "signature": { "type": ["string", "null"] },
          "settledAt": { "type": ["integer", "null"] },
          "checkoutUrl": { "type": "string" },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["signature", "state", "reason"],
              "properties": {
                "signature": { "type": "string" },
                "state": {
                  "type": "string",
                  "enum": ["pending", "rejected", "verified"]
                },
                "reason": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "PaymentEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Payment" },
          "meta": {
            "type": "object",
            "required": ["requestId"],
            "properties": { "requestId": { "type": "string" } }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "diagnostic": {
                "description": "Fixed configuration failure classification, returned only by GET /ready in dev. Never contains configuration values or upstream messages.",
                "type": "string",
                "enum": [
                  "APP_ENV_INVALID",
                  "CHECKOUT_ORIGIN_INVALID",
                  "RPC_URL_INVALID",
                  "RPC_URL_NOT_HTTPS",
                  "RPC_URL_HAS_CREDENTIALS",
                  "MERCHANTS_JSON_INVALID",
                  "MERCHANT_CONFIGURATION_INVALID",
                  "WEBHOOK_CONFIGURATION_INVALID",
                  "PRICE_KEY_MISSING",
                  "CHECKOUT_SECRET_TOO_SHORT",
                  "MERCHANTS_MISSING"
                ]
              }
            }
          }
        }
      }
    }
  }
}
