{
  "name": "crypto_gateway_backend",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "^10.5.1 || ^11.3.0"
  },
  "scripts": {
    "ci:quality": "npm run check",
    "audit:dependencies": "npm audit && npm audit --omit=dev",
    "dev": "wrangler dev --local --port 8787 --test-scheduled",
    "dev:scheduler": "node scripts/local-scheduler.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "credential:hash": "node scripts/hash-credential.mjs",
    "merchant": "node --experimental-transform-types scripts/merchant.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run audit:dependencies"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-tsdoc": "0.5.4",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.3",
    "wrangler": "4.154.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch@10": "11.0.3",
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
