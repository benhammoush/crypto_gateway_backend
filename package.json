{
  "name": "crypto_gateway_backend",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ci:quality": "npm run check && npm audit --audit-level=high",
    "dev": "wrangler dev --local --port 8787 --test-scheduled",
    "dev:scheduler": "node scripts/local-scheduler.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "credential:hash": "node scripts/hash-credential.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.3",
    "wrangler": "4.149.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
