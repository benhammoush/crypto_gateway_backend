# Copy to .dev.vars, then configure locally. Never commit the populated file.
# PAYMENTS_ENABLED stays false until a real Devnet recipient and provider key exist.
PAYMENTS_ENABLED=false
JUPITER_API_KEY=
CHECKOUT_SECRET=
# Optional for polling-only merchants; required to deliver encrypted webhook secrets.
# JSON: {"active":"key-id","keys":{"key-id":"<64 lowercase hex characters>"}}
# Generate a distinct random 256-bit key per environment and retain a secure recovery copy.
MERCHANT_ENCRYPTION_KEYS=
